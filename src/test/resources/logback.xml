<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <contextListener class="pe.financieraoh.framework.logging.config.LoggingFrameworkConfig"/>
    <springProperty scope="context" name="servicio" source="spring.application.name"/>


            <appender name="CONSOLE"
                      class="ch.qos.logback.core.ConsoleAppender">
                <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
            </appender>

            <root level="${LOG_LEVEL}">
                <appender-ref ref="CONSOLE" />
            </root>
</configuration>